# Copy to .env.local for development, and set the same in the Vercel
# project's environment variables for production.

# The URL of the real contact-form backend. Server-side only — never
# prefixed with NEXT_PUBLIC_, since there's no reason to expose it to the
# browser. See app/api/contact/route.ts for the full contract (what it
# POSTs, what response shape it expects back).
#
# Until this is set, the contact form's /api/contact route returns a 503
# and the form shows "The contact backend isn't connected yet" instead of
# silently failing.
CONTACT_API_URL=
